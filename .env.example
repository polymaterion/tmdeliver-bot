# Скопируй этот файл в .env и заполни реальными значениями:
#   cp .env.example .env
#   nano .env
#
# Файл .env НЕ коммитится в Git (см. .gitignore) — в нём секреты.

# ── Telegram ──────────────────────────────────────────────────────────────
# Токен бота, выданный @BotFather
BOT_TOKEN=

# ID администраторов через запятую (свой user_id можно узнать у @userinfobot)
ADMIN_IDS=

# ID или @username канала, куда публикуются объявления.
# Для приватного канала — числовой ID вида -100XXXXXXXXXX
CHANNEL_ID=

# ── Ссылки в постах ───────────────────────────────────────────────────────
# Прямая ссылка на бота, например https://t.me/tmdeliverbot
# Если не задать — бот соберёт её сам как https://t.me/<username бота>
BOT_URL=

# Ссылка для буста канала (используется только в BOOST_URL-совместимом коде,
# сейчас в постах показывается "Найти попутчика" вместо буста — можно не заполнять)
BOOST_URL=

# Username для кнопки помощи/поддержки (без @)
HELP_USERNAME=kabulbeg

# Смещение часового пояса от UTC (Москва/Ашхабад = 3)
TZ_OFFSET=3

# ── База данных ───────────────────────────────────────────────────────────
# Пароль для контейнера PostgreSQL, который поднимает docker-compose.yml.
# Придумай длинный случайный пароль, например:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# DATABASE_URL задавать НЕ нужно — docker-compose.yml собирает её сам из
# POSTGRES_PASSWORD выше и передаёт боту напрямую.


# ── Оплата переводом на карту ─────────────────────────────────────────────
# Номер карты, который бот показывает пользователю при покупке пакета.
# Меняется здесь, без правки кода (после правки: docker compose up -d --force-recreate bot).
CARD_NUMBER=
# Имя получателя (необязательно) — показывается под номером карты
CARD_HOLDER=
